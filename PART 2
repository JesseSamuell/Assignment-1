class Node:
    def __init__(self, data):
        self.data = data  
        self.next = None  


node1 = Node("iPhone 17")
node2 = Node("Samsung S26")
node3 = Node("Blackberry")

# 2. Link them together
node1.next = node2
node2.next = node3

current = node1
while current is not None:
    print(current.data)
    current = current.next
